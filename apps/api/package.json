{
  "name": "api",
  "version": "1.0.1",
  "description": "FastShip Next.js API Server",
  "private": true,
   "packageManager": "npm@10.2.4",
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "postinstall": "npx prisma db push --schema=./lib/prisma/schema.prisma --accept-data-loss",
    "prisma:generate": "prisma generate --schema=./lib/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "next": "16.2.0",
    "react": "^19",
    "react-dom": "^19",
    "@fastship/lib": "file:../../packages/lib/server",
    "@fastship/db": "file:../../packages/db",
    "zod": "^3.24.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.5",
    "typescript": "5.7.3",
    "eslint": "^8.54.0",
    "eslint-config-next": "16.2.0"
  }
}