// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============ ENUMS ============
enum UserRole {
  SELLER
  DRIVER
  BUSINESS
  ADMIN
}

enum ShipmentStatus {
  PENDING
  ASSIGNED
  PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
  RETURNED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PREPAID
  COD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  CREDIT
  DEBIT
  COMMISSION
  SETTLEMENT
  TOPUP
  ESCROW_CUT
  ESCROW_LOCK
  ESCROW_RELEASE
}

enum SettlementStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum NotificationType {
  ORDER_CREATED
  ORDER_ASSIGNED
  PICKUP_READY
  IN_TRANSIT
  DELIVERED
  PAYMENT_RECEIVED
  SETTLEMENT_READY
  SYSTEM_ALERT
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_DELIVERY
}

enum IntegrationType {
  SHOPIFY
  WOOCOMMERCE
  BIGCOMMERCE
  SQUARE
}

enum IntegrationSyncStatus {
  IDLE
  SYNCING
  SUCCESS
  FAILED
}

enum ApplicationType {
  SELLER
  DRIVER
  RATE_CHANGE
  BUSINESS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============ MULTI-CURRENCY ENUMS ============
enum Currency {
  USD
  EUR
  GBP
  INR
  AED
  PKR
  SGD
  MYR
  THB
  IDR
}

enum ReconciliationAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReconciliationAlertType {
  BALANCE_MISMATCH
  CURRENCY_MISMATCH
  EXCHANGE_RATE_ANOMALY
  UNDERPAYMENT
  OVERPAYMENT
  PROCESSING_FAILURE
}

// ============ MODELS ============

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  phone             String   @unique
  name              String
  password          String
  role              UserRole
  profileImage      String?
  isVerified        Boolean  @default(false)
  isActive          Boolean  @default(true)
  preferredCurrency Currency @default(USD)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  seller    Seller?
  driver    Driver?
  business  Business?
  auditLogs AuditLog[]
  apiKeys   ApiKey[]   @relation("apiKeys")

  @@index([email])
  @@index([role])
}

model Seller {
  id                 String   @id @default(cuid())
  userId             String   @unique
  companyName        String
  businessType       String
  taxId              String   @unique
  address            String
  city               String
  state              String
  zipCode            String
  bankAccount        String?
  bankName           String?
  accountHolder      String?
  warehouseName      String?
  warehouseAddress   String?
  warehouseCity      String?
  warehouseState     String?
  warehouseZipCode   String?
  warehouseLatitude  Float?
  warehouseLongitude Float?
  warehousePhone     String?
  rating             Float    @default(5.0)
  totalOrders        Int      @default(0)
  cancelledOrders    Int      @default(0)
  isVerified         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments    Shipment[]
  wallet       Wallet?
  bids         Bid[]
  integrations Integration[]
  disputes     Dispute[]

  @@index([userId])
  @@index([companyName])
}

model Driver {
  id                  String       @id @default(cuid())
  userId              String       @unique
  licenseNumber       String       @unique
  licenseExpiry       DateTime
  licenseImage        String?
  vehicleType         String
  vehicleNumber       String       @unique
  vehicleImage        String?
  insuranceProvider   String?
  insuranceNumber     String?
  status              DriverStatus @default(ACTIVE)
  isVerified          Boolean      @default(false)
  isActive            Boolean      @default(true)
  rating              Float        @default(5.0)
  totalDeliveries     Int          @default(0)
  cancelledDeliveries Int          @default(0)
  totalEarnings       Float        @default(0)
  currentDebt         Float        @default(0)
  currentLocation     String?
  latitude            Float?
  longitude           Float?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments DriverAssignment[]
  wallet      Wallet?
  earnings    Earning[]
  debts       DriverDebt[]
  approvals   Approval[]
  disputes    Dispute[]
  business    Business?          @relation(fields: [businessId], references: [id])
  businessId  String?

  @@index([userId])
  @@index([licenseNumber])
  @@index([isActive])
}

model Business {
  id                String   @id @default(cuid())
  userId            String   @unique
  companyName       String
  businessType      String
  operatingRegion   String
  commissionRate    Float    @default(10.0)
  insuranceProvider String?
  insuranceNumber   String?
  bankAccount       String?
  bankName          String?
  accountHolder     String?
  rating            Float    @default(5.0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rateCards         RateCard[]
  drivers           Driver[]
  wallet            Wallet?
  settlements       Settlement[]
  bids              Bid[]
  serviceAreas      BusinessServiceArea[]
  approvals         Approval[]
  driverAssignments DriverAssignment[]

  @@index([userId])
  @@index([companyName])
}

model Shipment {
  id                String         @id @default(cuid())
  sellerId          String
  businessId        String?
  pickupName        String
  pickupPhone       String
  pickupAddress     String
  pickupCity        String
  pickupState       String
  pickupZipCode     String
  pickupLatitude    Float?
  pickupLongitude   Float?
  deliveryName      String
  deliveryPhone     String
  deliveryAddress   String
  deliveryCity      String
  deliveryState     String
  deliveryZipCode   String
  deliveryLatitude  Float?
  deliveryLongitude Float?
  weight            Float
  distance          Float? // Distance in kilometers (calculated at creation time)
  dimensions        String?
  packageType       String
  isInCityDelivery  Boolean        @default(false) // True if pickup and delivery are in the same city
  description       String
  paymentMethod     PaymentMethod  @default(PREPAID)
  codAmount         Float?
  codAmount_cents   Int?           @default(0) // Store COD amount in cents for accuracy (used for calculation in backed only)
  expectedRate      Float?
  actualRate        Float?
  actualRate_cents  Int?           @default(0) // Store actual rate in cents for accuracy (used for calculation in backed only)
  status            ShipmentStatus @default(PENDING)
  priority          String         @default("STANDARD")
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  pickedUpAt        DateTime?
  deliveredAt       DateTime?

  codAmountDisplay    Float?    @default(0) // COD amount in local currency
  expectedRateDisplay Float?    @default(0) // Expected rate in local currency
  actualRateDisplay   Float?    @default(0) // Actual rate in local currency
  currency            Currency? @default(USD) // local currecy at the time user created the shipment, used for display purposes
  exchangeRate        Float?    @default(1) // Exchange rate used for display amounts

  seller        Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  assignment    DriverAssignment?
  payment       Payment?
  tracking      Tracking?
  activities    ShipmentActivity[]
  bids          Bid[]
  shopifyOrders ShopifyOrder[]

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod])
}

model DriverAssignment {
  id                  String    @id @default(cuid())
  shipmentId          String    @unique
  driverId            String
  businessId          String
  assignedAt          DateTime  @default(now())
  pickupCompletedAt   DateTime?
  deliveryCompletedAt DateTime?
  assignmentStatus    String    @default("ASSIGNED")
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  driver   Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([businessId])
  @@index([shipmentId])
}

model RateCard {
  id                    String   @id @default(cuid())
  businessId            String
  name                  String
  description           String?
  baseRate              Float
  baseRate_cents        Int      @default(0) // Store base rate in cents for accuracy (used for calculation in backed only)
  perKmRate             Float
  perKmRate_cents       Int      @default(0) // Store base rate in cents for accuracy (used for calculation in backed only)
  minimumDistance       Float    @default(0)
  maximumDistance       Float    @default(999999)
  minWeight             Float    @default(0)
  maxWeight             Float    @default(100)
  weightSurcharge       Float    @default(0) // Extra charge per kg above minWeight
  weightSurcharge_cents Int      @default(0) // Store base rate in cents for accuracy (used for calculation in backed only)
  serviceStates         String[] @default([]) // States/regions served: ["Sindh", "Punjab"]
  inCityDelivery        Boolean  @default(false) // Support in-city delivery (same city, within distance)
  serviceCities         String[] @default([]) // Specific cities supporting in-city: ["Peshawar", "Karachi"]
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([isActive])
}

model Wallet {
  id                     String   @id @default(cuid())
  balance                Float    @default(0) // Keep for backward compatibility, but will be generated from balance_cents
  balance_cents          Int?     @default(0) // Store balance in cents for accuracy (used for calculation in backed only)
  currency               Currency @default(USD)
  escrowBalance          Float    @default(0) // Keep for backward compatibility, but will be generated from balance_cents
  escrowBalance_cents    Int?     @default(0)
  totalEarnings          Float    @default(0) // Keep for backward compatibility, but will be generated from balance_cents
  totalEarnings_cents    Int?     @default(0)
  totalWithdrawals       Float    @default(0) // Keep for backward compatibility, but will be generated from balance_cents
  totalWithdrawals_cents Int?     @default(0)
  lastUpdated            DateTime @updatedAt
  createdAt              DateTime @default(now())

  sellerId   String? @unique
  driverId   String? @unique
  businessId String? @unique

  seller               Seller?               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  driver               Driver?               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  business             Business?             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  ledgerEntries        LedgerEntry[]
  reconciliationLogs   ReconciliationLog[]
  reconciliationAlerts ReconciliationAlert[]

  @@index([sellerId])
  @@index([driverId])
  @@index([businessId])
}

model Transaction {
  id              String          @id @default(cuid())
  walletId        String
  type            TransactionType
  amount          Float           @default(0) // Keep for backward compatibility, but will be generated from amount_cents
  amount_cents    Int?            @default(0) // Store amount in cents for accuracy (used for calculation in backed only)
  currency        Currency        @default(USD)
  exchangeRate    Float           @default(1) // Exchange rate used for this transaction
  displayAmount   Float? // Amount in user's display currency
  description     String
  referenceId     String?
  status          PaymentStatus   @default(PENDING)
  createdAt       DateTime        @default(now())
  completedAt     DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@index([type])
}

model Payment {
  id                   String        @id @default(cuid())
  shipmentId           String        @unique
  amount               Float         @default(0) // Keep for backward compatibility, but will be generated from amount_cents
  amount_cents         Int?          @default(0) // Store amount in cents for accuracy (used for calculation in backed only)
  tax                  Float         @default(0) // Keep for backward compatibility, but will be generated from amount_cents
  tax_cents            Int?          @default(0) // Store amount in cents for accuracy (used for calculation in backed only)
  commission           Float         @default(0) // Keep for backward compatibility, but will be generated from amount_cents
  commission_cents     Int?          @default(0) // Store amount in cents for accuracy (used for calculation in backed only)
  driverPayable        Float         @default(0) // Keep for backward compatibility, but will be generated from amount_cents
  driverPayable_cents  Int?          @default(0) // Store amount in cents for accuracy (used for calculation in backed only)
  currency             Currency      @default(USD)
  exchangeRate         Float         @default(1) // at that time the exchange rate of USD and user's  currency
  amountDisplay        Float?        @default(0) // Amount in user's local currency
  taxDisplay           Float?        @default(0) // Tax in user's local currency
  commissionDisplay    Float?        @default(0) // Commission in user's local currency
  driverPayableDisplay Float?        @default(0) // Driver payable in user's local currency
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus @default(PENDING)
  transactionId        String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  paidAt               DateTime?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([paymentStatus])
}

model LedgerEntry {
  id                  String   @id @default(uuid())
  walletId            String
  amount              Float    @default(0) // +credit / -debit
  amount_cents        Int?     @default(0) // Store amount in cents for accuracy (used for calculation in backed only)
  type                String // CREDIT / DEBIT
  category            String // escrow, fee, transfer
  referenceId         String?
  balanceAfter        Float
  balanceAfter_cents  Int?     @default(0) // Store balance in cents for accuracy (used for calculation in backed only)
  amountDisplay       Float?   @default(0) // Amount in user's local currency
  balanceAfterDisplay Float?   @default(0) // Balance in user's local currency
  currency            Currency @default(USD)
  exchangeRate        Float    @default(1) // Exchange rate used for this entry
  createdAt           DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([referenceId])
}

model ReconciliationLog {
  id               String   @id @default(cuid())
  walletId         String
  expected         Float    @default(0) // Expected balance from ledger
  expected_cents   Int?     @default(0) // Store amount in cents for accuracy (used for calculation in backed only)
  actual           Float    @default(0) // Actual balance in wallet
  actual_cents     Int?     @default(0) // Store amount in cents for accuracy (used for calculation in backed only)
  difference       Float    @default(0) // Difference (expected - actual)
  difference_cents Int?     @default(0) // Store amount in cents for accuracy (used for calculation in backed only))
  currency         Currency @default(USD)
  status           String // OK, FIXED, ERROR
  message          String? // Description of what happened
  createdAt        DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@index([createdAt])
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String   @unique
  scope       String // e.g. "releaseEscrow", "failDelivery"
  requestHash String?
  response    Json?
  createdAt   DateTime @default(now())
}

model Tracking {
  id                String         @id @default(cuid())
  shipmentId        String         @unique
  currentStatus     ShipmentStatus
  currentLocation   String?
  latitude          Float?
  longitude         Float?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  updatedAt         DateTime       @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model ShipmentActivity {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  description String
  location    String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([createdAt])
}

model Earning {
  id            String    @id @default(cuid())
  driverId      String
  shipmentId    String?
  amount        Float     @default(0)
  amount_cents  Int?      @default(0) // Store amount in cents for accuracy (used for calculation in backed only)
  earnedAt      DateTime  @default(now())
  amountDisplay Float?    @default(0) // Amount in user's local currency
  currency      Currency? @default(USD) // local currecy at the time earning was recorded, used for display purposes
  exchangeRate  Float?    @default(1) // Exchange rate used for display amount
  settlementId  String?
  isSettled     Boolean   @default(false)
  settledAt     DateTime?
  createdAt     DateTime  @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([isSettled])
  @@index([createdAt])
}

model DriverDebt {
  id            String    @id @default(cuid())
  driverId      String
  shipmentId    String?
  amount        Float     @default(0)
  amount_cents  Int?      @default(0) // Store amount in cents for accuracy (used for calculation in backed only)
  amountDisplay Float?    @default(0) // Amount in user's local currency
  currency      Currency? @default(USD) // local currecy at the time debt
  exchangeRate  Float?    @default(1) // Exchange rate used for display amount
  debtReason    String
  incurredAt    DateTime  @default(now())
  settledAt     DateTime?
  isSettled     Boolean   @default(false)
  settlementId  String?
  createdAt     DateTime  @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([isSettled])
  @@index([createdAt])
}

model Settlement {
  id                 String           @id @default(cuid())
  businessId         String
  driverId           String?
  periodStart        DateTime
  periodEnd          DateTime
  totalAmount        Float            @default(0)
  totalAmount_cents  Int?             @default(0) // Store total amount in cents for accuracy (used for calculation in backed only) 
  commission         Float            @default(0)
  commission_cents   Int?             @default(0) // Store total amount in cents for accuracy (used for calculation in backed only)
  netAmount          Float            @default(0)
  netAmount_cents    Int?             @default(0) // Store total amount in cents for accuracy (used for calculation in backed only)
  status             SettlementStatus @default(PENDING)
  notes              String?
  settledAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  totalAmountDisplay Float?           @default(0) // Amount in user's local currency
  commissionDisplay  Float?           @default(0) // Amount in user's local currency
  netAmountDisplay   Float?           @default(0) // Amount in user's local currency
  currency           Currency?        @default(USD) // local currecy at the time settlement was created, used for display purposes
  exchangeRate       Float?           @default(1) // Exchange rate used for display amounts
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}

model Bid {
  id                  String    @id @default(cuid())
  sellerId            String
  shipmentId          String?
  businessId          String?
  amount              Float     @default(0) // Keep for backward compatibility, but will be generated from amount_cents
  amount_cents        Int?      @default(0) // Store bid amount in cents for accuracy (used for calculation in backed only)
  description         String? // Custom terms or special notes
  distance            Float? // Calculated distance for this bid
  estimatedPickupTime DateTime? // Estimated when business can pickup
  bidStatus           BidStatus @default(PENDING)
  isAccepted          Boolean   @default(false)
  acceptedAt          DateTime?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  amountDisplay       Float?    @default(0) // Bid amount in user's local currency
  currency            Currency? @default(USD) // local currecy at the time bid was created, used for display purposes
  exchangeRate        Float?    @default(1) // Exchange rate used for display amount
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  seller   Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([shipmentId])
  @@index([bidStatus])
  @@index([expiresAt])
}

model BusinessServiceArea {
  id            String   @id @default(cuid())
  businessId    String
  state         String // State/province name
  city          String // City/region name
  activeDrivers Int      @default(0)
  capacity      Int      @default(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, state, city])
  @@index([businessId])
  @@index([state])
  @@index([city])
}

model Integration {
  id              String          @id @default(cuid())
  sellerId        String
  integrationType IntegrationType

  // OAuth & Credentials (encrypted at rest)
  accessToken  String?
  refreshToken String?
  apiKey       String?
  apiSecret    String?

  // Shopify-specific fields
  shopifyStoreUrl String? // e.g., "mystore.myshopify.com"

  // Sync metadata
  lastSyncedAt     DateTime?
  syncStatus       IntegrationSyncStatus @default(IDLE)
  lastSyncErrorMsg String?
  webhookUrl       String?

  // Status
  isActive Boolean @default(true)
  metadata String? // JSON for future extensibility

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller        Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shopifyOrders ShopifyOrder[]

  @@unique([sellerId, integrationType])
  @@index([sellerId])
  @@index([integrationType])
  @@index([isActive])
}

model ShopifyOrder {
  id                 String  @id @default(cuid())
  integrationId      String
  shopifyOrderId     String // Shopify's order ID
  shopifyOrderNumber String // Human-readable order number
  shipmentId         String?

  syncedAt         DateTime  @default(now())
  lastStatusSyncAt DateTime?

  metadata  String? // JSON: original Shopify order data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  shipment    Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@unique([integrationId, shopifyOrderId])
  @@index([integrationId])
  @@index([shipmentId])
}

model ReconciliationAlert {
  id             String                      @id @default(cuid())
  walletId       String
  logId          String
  severity       ReconciliationAlertSeverity @default(MEDIUM)
  type           ReconciliationAlertType     @default(BALANCE_MISMATCH)
  message        String
  expectedCents  Int
  actualCents    Int
  diffCents      Int
  currency       Currency                    @default(USD)
  status         String // NEW | ACKNOWLEDGED | RESOLVED
  resolution     String?
  description    String?
  createdAt      DateTime                    @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  wallet         Wallet                      @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([severity])
  @@index([type])
  @@index([status])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  pair      String   @unique // e.g. "USD_EUR"
  from      Currency
  to        Currency
  rate      Float
  source    String   @default("exchangerate-api.com") // API source
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([from])
  @@index([to])
  @@index([updatedAt])
}

model Notification {
  id         Int      @unique @default(autoincrement())
  type       String // RECONCILIATION_ALERT
  severity   String // CRITICAL | HIGH | MEDIUM | LOW
  title      String
  message    String
  relatedId  String
  targetRole String // ADMIN | FINANCE_TEAM
  status     String // PENDING | SENT | READ
  createdAt  DateTime
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String
  changes    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ApiKey {
  id                String    @id @default(cuid())
  userId            String
  name              String
  keyHash           String    @unique // Hashed version of the actual key (never store plain text)
  prefix            String    @unique // First 8 chars of key for display (e.g. "sk_test_abc123...")
  scope             String    @default("all") // Comma-separated permissions: "read,write,admin"
  rateLimit         Int       @default(1000) // Requests per hour
  lastUsedAt        DateTime?
  lastUsedIp        String?
  requestCount      Int       @default(0) // Total requests made with this key
  requestCountHour  Int       @default(0) // Requests in current hour
  requestCountReset DateTime  @default(now())
  isActive          Boolean   @default(true)
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime?

  user User @relation("apiKeys", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
  @@index([keyHash])
}

model Approval {
  id         String  @id @default(cuid())
  driverId   String?
  businessId String?

  // Applicant info (before account creation)
  email String
  phone String
  name  String

  // Application-specific data
  applicationType ApplicationType
  status          ApprovalStatus  @default(PENDING)

  // For drivers
  licenseNumber String?
  licenseExpiry DateTime?
  vehicleType   String?
  vehicleNumber String?

  // For businesses
  companyName     String?
  businessType    String?
  operatingRegion String?

  // Admin workflow
  submittedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  approvedAt      DateTime?
  rejectionReason String?
  reviewedBy      String? // Admin user ID who approved/rejected
  metadata        String? // JSON for additional details

  driver   Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([email, applicationType]) // Prevent duplicate applications
  @@index([email])
  @@index([driverId])
  @@index([businessId])
  @@index([applicationType])
  @@index([status])
  @@index([submittedAt])
}

model Dispute {
  id          String    @id @default(cuid())
  shipmentId  String
  sellerId    String?
  driverId    String?
  reason      String
  description String?
  amount      Float
  status      String    @default("OPEN") // OPEN, RESOLVED, REJECTED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([sellerId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}
