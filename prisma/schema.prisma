// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============ ENUMS ============
enum UserRole {
  SELLER
  DRIVER
  BUSINESS
  ADMIN
}

enum ShipmentStatus {
  PENDING
  ASSIGNED
  PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
  RETURNED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PREPAID
  COD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  CREDIT
  DEBIT
  COMMISSION
  SETTLEMENT
  TOPUP
  ESCROW_LOCK
  ESCROW_RELEASE
}

enum SettlementStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum NotificationType {
  ORDER_CREATED
  ORDER_ASSIGNED
  PICKUP_READY
  IN_TRANSIT
  DELIVERED
  PAYMENT_RECEIVED
  SETTLEMENT_READY
  SYSTEM_ALERT
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_DELIVERY
}

enum IntegrationType {
  SHOPIFY
  WOOCOMMERCE
  BIGCOMMERCE
  SQUARE
}

enum IntegrationSyncStatus {
  IDLE
  SYNCING
  SUCCESS
  FAILED
}

enum ApplicationType {
  SELLER
  DRIVER
  RATE_CHANGE
  BUSINESS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============ MODELS ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String   @unique
  name         String
  password     String
  role         UserRole
  profileImage String?
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  seller        Seller?
  driver        Driver?
  business      Business?
  notifications Notification[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]       @relation("apiKeys")

  @@index([email])
  @@index([role])
}

model Seller {
  id                 String   @id @default(cuid())
  userId             String   @unique
  companyName        String
  businessType       String
  taxId              String   @unique
  address            String
  city               String
  state              String
  zipCode            String
  bankAccount        String?
  bankName           String?
  accountHolder      String?
  warehouseName      String?
  warehouseAddress   String?
  warehouseCity      String?
  warehouseState     String?
  warehouseZipCode   String?
  warehouseLatitude  Float?
  warehouseLongitude Float?
  warehousePhone     String?
  rating             Float    @default(5.0)
  totalOrders        Int      @default(0)
  cancelledOrders    Int      @default(0)
  isVerified         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments    Shipment[]
  wallet       Wallet?
  bids         Bid[]
  integrations Integration[]
  disputes     Dispute[]

  @@index([userId])
  @@index([companyName])
}

model Driver {
  id                  String       @id @default(cuid())
  userId              String       @unique
  licenseNumber       String       @unique
  licenseExpiry       DateTime
  licenseImage        String?
  vehicleType         String
  vehicleNumber       String       @unique
  vehicleImage        String?
  insuranceProvider   String?
  insuranceNumber     String?
  status              DriverStatus @default(ACTIVE)
  isVerified          Boolean      @default(false)
  isActive            Boolean      @default(true)
  rating              Float        @default(5.0)
  totalDeliveries     Int          @default(0)
  cancelledDeliveries Int          @default(0)
  totalEarnings       Float        @default(0)
  currentDebt         Float        @default(0)
  currentLocation     String?
  latitude            Float?
  longitude           Float?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments DriverAssignment[]
  wallet      Wallet?
  earnings    Earning[]
  debts       DriverDebt[]
  approvals   Approval[]
  disputes    Dispute[]
  business    Business?          @relation(fields: [businessId], references: [id])
  businessId  String?

  @@index([userId])
  @@index([licenseNumber])
  @@index([isActive])
}

model Business {
  id                String   @id @default(cuid())
  userId            String   @unique
  companyName       String
  businessType      String
  operatingRegion   String
  commissionRate    Float    @default(10.0)
  insuranceProvider String?
  insuranceNumber   String?
  bankAccount       String?
  bankName          String?
  accountHolder     String?
  rating            Float    @default(5.0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rateCards         RateCard[]
  drivers           Driver[]
  wallet            Wallet?
  settlements       Settlement[]
  bids              Bid[]
  serviceAreas      BusinessServiceArea[]
  approvals         Approval[]
  driverAssignments DriverAssignment[]

  @@index([userId])
  @@index([companyName])
}

model Shipment {
  id                String         @id @default(cuid())
  sellerId          String
  businessId        String?
  pickupName        String
  pickupPhone       String
  pickupAddress     String
  pickupCity        String
  pickupState       String
  pickupZipCode     String
  pickupLatitude    Float?
  pickupLongitude   Float?
  deliveryName      String
  deliveryPhone     String
  deliveryAddress   String
  deliveryCity      String
  deliveryState     String
  deliveryZipCode   String
  deliveryLatitude  Float?
  deliveryLongitude Float?
  weight            Float
  distance          Float? // Distance in kilometers (calculated at creation time)
  dimensions        String?
  packageType       String
  isInCityDelivery  Boolean        @default(false) // True if pickup and delivery are in the same city
  description       String
  paymentMethod     PaymentMethod  @default(PREPAID)
  codAmount         Float?
  expectedRate      Float?
  actualRate        Float?
  status            ShipmentStatus @default(PENDING)
  priority          String         @default("STANDARD")
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  pickedUpAt        DateTime?
  deliveredAt       DateTime?

  seller        Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  assignment    DriverAssignment?
  payment       Payment?
  tracking      Tracking?
  activities    ShipmentActivity[]
  bids          Bid[]
  shopifyOrders ShopifyOrder[]

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod])
}

model DriverAssignment {
  id                  String    @id @default(cuid())
  shipmentId          String    @unique
  driverId            String
  businessId          String
  assignedAt          DateTime  @default(now())
  pickupCompletedAt   DateTime?
  deliveryCompletedAt DateTime?
  assignmentStatus    String    @default("ASSIGNED")
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  driver   Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([businessId])
  @@index([shipmentId])
}

model RateCard {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  baseRate        Float
  perKmRate       Float
  minimumDistance Float    @default(0)
  maximumDistance Float    @default(999999)
  minWeight       Float    @default(0)
  maxWeight       Float    @default(100)
  weightSurcharge Float    @default(0) // Extra charge per kg above minWeight
  serviceStates   String[] @default([]) // States/regions served: ["Sindh", "Punjab"]
  inCityDelivery  Boolean  @default(false) // Support in-city delivery (same city, within distance)
  serviceCities   String[] @default([]) // Specific cities supporting in-city: ["Peshawar", "Karachi"]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([isActive])
}

model Wallet {
  id               String   @id @default(cuid())
  balance          Float    @default(0)
  escrowBalance    Float    @default(0)
  totalEarnings    Float    @default(0)
  totalWithdrawals Float    @default(0)
  lastUpdated      DateTime @updatedAt
  createdAt        DateTime @default(now())

  sellerId   String? @unique
  driverId   String? @unique
  businessId String? @unique

  seller                Seller?              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  driver                Driver?              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  business              Business?            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  ledgerEntries         LedgerEntry[]
  reconciliationLogs    ReconciliationLog[]

  @@index([sellerId])
  @@index([driverId])
  @@index([businessId])
}

model Transaction {
  id          String          @id @default(cuid())
  walletId    String
  type        TransactionType
  amount      Float
  description String
  referenceId String?
  status      PaymentStatus   @default(PENDING)
  createdAt   DateTime        @default(now())
  completedAt DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@index([type])
}

model Payment {
  id            String        @id @default(cuid())
  shipmentId    String        @unique
  amount        Float
  tax           Float         @default(0)
  commission    Float         @default(0)
  driverPayable Float
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  transactionId String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  paidAt        DateTime?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([paymentStatus])
}

model LedgerEntry {
  id           String  @id @default(uuid())
  walletId     String
  amount       Float // +credit / -debit
  type         String // CREDIT / DEBIT
  category     String // escrow, fee, transfer
  referenceId  String?
  balanceAfter Float

  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([referenceId])
}

model ReconciliationLog {
  id         String   @id @default(cuid())
  walletId   String
  expected   Float // Expected balance from ledger
  actual     Float // Actual balance in wallet
  difference Float // Difference (expected - actual)
  status     String // OK, FIXED, ERROR
  message    String? // Description of what happened
  createdAt  DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@index([createdAt])
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String   @unique
  scope       String // e.g. "releaseEscrow", "failDelivery"
  requestHash String?
  response    Json?
  createdAt   DateTime @default(now())
}

model Tracking {
  id                String         @id @default(cuid())
  shipmentId        String         @unique
  currentStatus     ShipmentStatus
  currentLocation   String?
  latitude          Float?
  longitude         Float?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  updatedAt         DateTime       @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model ShipmentActivity {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  description String
  location    String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([createdAt])
}

model Earning {
  id           String    @id @default(cuid())
  driverId     String
  shipmentId   String?
  amount       Float
  earnedAt     DateTime  @default(now())
  settlementId String?
  isSettled    Boolean   @default(false)
  settledAt    DateTime?
  createdAt    DateTime  @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([isSettled])
  @@index([createdAt])
}

model DriverDebt {
  id           String    @id @default(cuid())
  driverId     String
  shipmentId   String?
  amount       Float
  debtReason   String
  incurredAt   DateTime  @default(now())
  settledAt    DateTime?
  isSettled    Boolean   @default(false)
  settlementId String?
  createdAt    DateTime  @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([isSettled])
  @@index([createdAt])
}

model Settlement {
  id          String           @id @default(cuid())
  businessId  String
  driverId    String?
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Float
  commission  Float            @default(0)
  netAmount   Float
  status      SettlementStatus @default(PENDING)
  notes       String?
  settledAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}

model Bid {
  id                  String    @id @default(cuid())
  sellerId            String
  shipmentId          String?
  businessId          String?
  amount              Float
  description         String? // Custom terms or special notes
  distance            Float? // Calculated distance for this bid
  estimatedPickupTime DateTime? // Estimated when business can pickup
  bidStatus           BidStatus @default(PENDING)
  isAccepted          Boolean   @default(false)
  acceptedAt          DateTime?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  seller   Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([shipmentId])
  @@index([bidStatus])
  @@index([expiresAt])
}

model BusinessServiceArea {
  id            String   @id @default(cuid())
  businessId    String
  state         String // State/province name
  city          String // City/region name
  activeDrivers Int      @default(0)
  capacity      Int      @default(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, state, city])
  @@index([businessId])
  @@index([state])
  @@index([city])
}

model Integration {
  id              String          @id @default(cuid())
  sellerId        String
  integrationType IntegrationType

  // OAuth & Credentials (encrypted at rest)
  accessToken  String?
  refreshToken String?
  apiKey       String?
  apiSecret    String?

  // Shopify-specific fields
  shopifyStoreUrl String? // e.g., "mystore.myshopify.com"

  // Sync metadata
  lastSyncedAt     DateTime?
  syncStatus       IntegrationSyncStatus @default(IDLE)
  lastSyncErrorMsg String?
  webhookUrl       String?

  // Status
  isActive Boolean @default(true)
  metadata String? // JSON for future extensibility

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller        Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shopifyOrders ShopifyOrder[]

  @@unique([sellerId, integrationType])
  @@index([sellerId])
  @@index([integrationType])
  @@index([isActive])
}

model ShopifyOrder {
  id                 String  @id @default(cuid())
  integrationId      String
  shopifyOrderId     String // Shopify's order ID
  shopifyOrderNumber String // Human-readable order number
  shipmentId         String?

  syncedAt         DateTime  @default(now())
  lastStatusSyncAt DateTime?

  metadata  String? // JSON: original Shopify order data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  shipment    Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@unique([integrationId, shopifyOrderId])
  @@index([integrationId])
  @@index([shipmentId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  relatedId String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String
  changes    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ApiKey {
  id                String    @id @default(cuid())
  userId            String
  name              String
  keyHash           String    @unique // Hashed version of the actual key (never store plain text)
  prefix            String    @unique // First 8 chars of key for display (e.g. "sk_test_abc123...")
  scope             String    @default("all") // Comma-separated permissions: "read,write,admin"
  rateLimit         Int       @default(1000) // Requests per hour
  lastUsedAt        DateTime?
  lastUsedIp        String?
  requestCount      Int       @default(0) // Total requests made with this key
  requestCountHour  Int       @default(0) // Requests in current hour
  requestCountReset DateTime  @default(now())
  isActive          Boolean   @default(true)
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime?

  user User @relation("apiKeys", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
  @@index([keyHash])
}

model Approval {
  id         String  @id @default(cuid())
  driverId   String?
  businessId String?

  // Applicant info (before account creation)
  email String
  phone String
  name  String

  // Application-specific data
  applicationType ApplicationType
  status          ApprovalStatus  @default(PENDING)

  // For drivers
  licenseNumber String?
  licenseExpiry DateTime?
  vehicleType   String?
  vehicleNumber String?

  // For businesses
  companyName     String?
  businessType    String?
  operatingRegion String?

  // Admin workflow
  submittedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  approvedAt      DateTime?
  rejectionReason String?
  reviewedBy      String? // Admin user ID who approved/rejected
  metadata        String? // JSON for additional details

  driver   Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([email, applicationType]) // Prevent duplicate applications
  @@index([email])
  @@index([driverId])
  @@index([businessId])
  @@index([applicationType])
  @@index([status])
  @@index([submittedAt])
}

model Dispute {
  id          String    @id @default(cuid())
  shipmentId  String
  sellerId    String?
  driverId    String?
  reason      String
  description String?
  amount      Float
  status      String    @default("OPEN") // OPEN, RESOLVED, REJECTED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([sellerId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}
